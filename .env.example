# --- LLM provider API keys ---
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# --- Model routing ---
# Provider used by every agent unless overridden below. One of: openai, xai, gemini
DEFAULT_PROVIDER=openai
DEFAULT_MODEL_ID=gpt-5.2-2025-12-11

# Optional per-agent overrides (leave blank to use DEFAULT_PROVIDER)
WEB_SEARCH_PROVIDER=
MARKET_DATA_PROVIDER=
INVESTMENT_ANALYSIS_PROVIDER=
BUDGET_COACH_PROVIDER=
SAVINGS_STRATEGY_PROVIDER=
DEBT_REDUCTION_PROVIDER=
COORDINATOR_PROVIDER=

# --- Database ---
# Local dev default (no Docker needed): sqlite:///./fiscora.db
# Docker/production: postgresql://fiscora:fiscora@postgres:5432/fiscora
DATABASE_URL=sqlite:///./fiscora.db
AGENT_DB_FILE=fiscora_agents.db

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=1440

# --- Feature flags ---
FISCORA_DEBUG=true

# --- CORS ---
# Comma-separated origins the frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
